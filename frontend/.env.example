# Backend REST API URL (leave empty or / to use Vite proxy in dev)
VITE_API_BASE_URL=http://localhost:8080

# Configurable Firebase Auth Sign-in Method (email, anonymous, google)
VITE_FIREBASE_AUTH_SIGN_IN_METHOD=email

# Firebase Client Web Configuration (Public client identifiers ONLY)
# SECURITY NOTICE: Never place Google Cloud service account keys, private keys,
# or Kakao client secrets here. Only public web client configuration is permitted.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-gcp-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-gcp-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-gcp-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-fcm-sender-id
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
VITE_FIREBASE_VAPID_KEY=your-fcm-web-push-vapid-key

# Kakao Javascript SDK App Key (Optional for Kakao.Share API)
VITE_KAKAO_JAVASCRIPT_KEY=your-kakao-javascript-key
