# Flask environment: development | testing | production
FLASK_ENV=development
PORT=8080
LOG_LEVEL=INFO

# Google Cloud / Firebase configuration
# In deployed environments (e.g., Cloud Run, GKE), leave GOOGLE_APPLICATION_CREDENTIALS unset
# so the backend automatically uses Application Default Credentials (ADC).
# For local development, either run `gcloud auth application-default login`
# or set GOOGLE_APPLICATION_CREDENTIALS to a local path outside the repository.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
FIRESTORE_DATABASE=(default)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/local/service-account.json

# Firestore collection names
FIRESTORE_COLLECTION_SOURCES=sources
FIRESTORE_COLLECTION_ARTICLES=articles
FIRESTORE_COLLECTION_SHARE_MESSAGES=share_messages
FIRESTORE_COLLECTION_MESSAGES=shareable_messages
FIRESTORE_COLLECTION_USERS=users
FIRESTORE_SUBCOLLECTION_DEVICES=devices

# Optional internal webhook/scheduler key for automated content ingestion triggers
INTERNAL_INGEST_API_KEY=change-me-in-production

# CORS origins allowed (comma-separated)
CORS_ALLOWED_ORIGINS=*
